{
  "name": "xilixiwai-demo",
  "version": "4.0.0",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "description": "Standalone actor and studio demo; no IP workbench backend or data.",
  "scripts": {
    "start": "node scripts/serve.mjs",
    "test": "node --test tests/*.test.mjs",
    "build:store": "esbuild src/reliable-store.js --bundle --format=iife --global-name=ActorStore --minify --outfile=web/reliable-store.js",
    "build:guide": "node scripts/build-usage-guide.mjs",
    "build:demo-lab": "node scripts/build-demo-lab.mjs",
    "build:demo-operations": "node scripts/build-demo-operations.mjs",
    "build:demo-previs": "node scripts/build-demo-previs.mjs",
    "build:demo-tools": "node scripts/build-demo-tools.mjs",
    "build": "npm run build:demo-lab && npm run build:demo-operations && npm run build:demo-previs && npm run build:demo-tools && npm run build:guide && npm run build:store"
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "devDependencies": {
    "esbuild": "0.25.11",
    "fake-indexeddb": "6.2.6",
    "fflate": "^0.8.3",
    "idb-keyval": "^6.2.2",
    "linkedom": "0.18.14",
    "papaparse": "^5.5.3",
    "pdfjs-dist": "6.4.299"
  },
  "engines": {
    "node": ">=24.21.0"
  }
}
