+/* Keep record editing and saving reachable while reading long content. */
+.record-toolbar,.record-edit-toolbar{position:sticky;top:54px;z-index:1;background:var(--panel);padding:10px 0;margin-bottom:18px;border-bottom:1px solid var(--line)}.record-edit-toolbar{display:flex;align-items:center;justify-content:space-between;gap:12px}.record-edit-toolbar>span{font-size:12px;color:var(--muted)}.knowledge-quick-edit{margin-left:auto;font-size:12px;padding:5px 10px;min-height:32px}#record-form textarea[name=content]{min-height:320px;line-height:1.8}
